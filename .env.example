NODE_ENV=development
DB_HOST=127.0.0.1
DB_USER=user
DB_PASSWORD=password
DB_NAME=axocom
DB_PORT=3307
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Reverse proxies in front of the API, e.g. 1 behind a single load balancer.
# Needed so rate limits apply per visitor instead of to everyone behind the proxy.
TRUST_PROXY=
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=36w

# Razorpay. The key id is public (it is sent to the browser to open Checkout);
# the key secret signs orders and verifies payment signatures and must stay on
# the server. Find both under Razorpay Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_the_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_the_webhook_secret

# GST in basis points applied on top of listed prices (1800 = 18.00%).
# Charged per unit, then multiplied by quantity, the way an invoice line works.
GST_RATE_BPS=1800

# Testing only. When set, EVERY pass and plan is charged this many paise instead
# of its real price, so a payment can be driven end to end cheaply. Honoured
# only when NODE_ENV is development or test; ignored everywhere else. Leave
# unset unless you are deliberately testing payments.
# PAYMENT_TEST_AMOUNT_PAISE=100