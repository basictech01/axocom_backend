{
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/*.test.ts", "src/tests/**"],
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "lib": [
            "es2023"
        ],
        "target": "es2023",
        "module": "commonjs",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "types": [
            "node",
            "jest"
        ]
    }
}
